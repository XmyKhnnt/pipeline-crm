# Copy these values into your deployment environment. This project deliberately
# does not load .env files itself, so use your shell, process manager, or host.
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL to use SQLite locally, or use PostgreSQL in production.
DATABASE_URL=postgresql://pipeline_crm:change-me@localhost:5432/pipeline_crm
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Set these to true only once HTTPS is correctly terminated for the application.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
